<%- include('partials/head') %>
<style>
  /* ===== GLAMOURS-INSPIRED REPORT STYLES ===== */
  .report-tab { padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 600; color: #9ca3af; background: transparent; border: 1px solid rgba(255,255,255,0.08); white-space: nowrap; transition: all 0.2s; cursor: pointer; }
  .report-tab:hover { background: rgba(255,255,255,0.05); color: #f3f4f6; border-color: rgba(255,255,255,0.15); }
  .report-tab.active { background: rgba(212,175,55,0.12); color: #2563EB; border-color: rgba(212,175,55,0.35); font-weight: 700; }
  .rpt-card { background: linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.015) 100%); border: 1px solid rgba(255,255,255,0.08); border-radius: 18px; padding: 1.5rem; box-shadow: 0 16px 40px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.07); position: relative; overflow: hidden; transition: border-color 0.3s; }
  .rpt-card:hover { border-color: rgba(255,255,255,0.15); }
  .rpt-glow::after { content: ''; position: absolute; top: -50px; right: -50px; width: 170px; height: 170px; border-radius: 50%; background: radial-gradient(circle, rgba(212,175,55,0.12) 0%, transparent 70%); pointer-events: none; }

  /* ===== SECCIONES PLEGABLES =====
     Las 3 secciones de Reportes arrancan contraídas para ver la página de un
     vistazo. El encabezado es el botón: se abre y se cierra con un click. */
  .rpt-card.collapsed > .rpt-body { display: none; }
  .rpt-card.collapsed { padding-bottom: 1rem; }
  .rpt-toggle { display: flex; align-items: center; gap: 0.75rem; flex: 1 1 auto; cursor: pointer; text-align: left; background: none; border: 0; padding: 0; color: inherit; font: inherit; }
  .rpt-toggle:hover h2 { color: #d4af37; }
  .rpt-toggle:focus-visible { outline: 2px solid rgba(212,175,55,0.6); outline-offset: 4px; border-radius: 8px; }
  .rpt-caret { width: 1.25rem; height: 1.25rem; color: #8b9bb4; flex-shrink: 0; transition: transform 0.25s ease; }
  .rpt-card.collapsed .rpt-caret { transform: rotate(-90deg); }
  .rpt-hint { margin-left: auto; display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
  .rpt-chip { font-size: 0.7rem; padding: 0.15rem 0.55rem; border-radius: 999px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: #cbd5e0; white-space: nowrap; }
  .rpt-chip-alerta { background: rgba(239,68,68,0.15); border-color: rgba(239,68,68,0.35); color: #fca5a5; }
  .rpt-hdr { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .rpt-ico { width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .rpt-ico-gold { background: linear-gradient(135deg, #2563EB, #1D4ED8); box-shadow: 0 8px 20px rgba(212,175,55,0.25); }
  .rpt-ico-green { background: linear-gradient(135deg, #065f46, #047857); }
  .rpt-ico-purple { background: linear-gradient(135deg, #7e22ce, #9333ea); }
  .rpt-filters { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 1rem 1.25rem; }
  .rpt-hero { background: linear-gradient(135deg, #854d0e 0%, #a16207 40%, #ca8a04 100%); border: 1px solid rgba(212,175,55,0.3); border-radius: 16px; padding: 1.75rem 2rem; position: relative; overflow: hidden; box-shadow: 0 16px 40px rgba(202,138,4,0.18); }
  .rpt-btn { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #9ca3af; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s; white-space: nowrap; font-family: inherit; }
  .rpt-btn:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); color: #f3f4f6; }
  .rpt-btn-gold { background: rgba(212,175,55,0.12); border-color: rgba(212,175,55,0.3); color: #2563EB; }
  .rpt-btn-gold:hover { background: rgba(212,175,55,0.2); color: #00E5FF; }
  .rpt-stat { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; padding: 1.25rem; position: relative; overflow: hidden; transition: all 0.3s; }
  .rpt-stat::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, #2563EB, #1D4ED8); opacity: 0.6; }
  .rpt-stat:hover { border-color: rgba(255,255,255,0.12); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
  .rpt-qr { padding: 4px 10px; font-size: 11px; color: #9ca3af; background: transparent; border: 1px solid transparent; border-radius: 8px; cursor: pointer; transition: all 0.15s; font-weight: 500; font-family: inherit; }
  .rpt-qr:hover { color: #2563EB; background: rgba(212,175,55,0.08); border-color: rgba(212,175,55,0.2); }
  .rpt-div { border-top: 2px solid rgba(212,175,55,0.15); margin: 1rem 0; }
  .rpt-input { width: 100%; padding: 8px 12px; background: rgba(12,16,26,0.5); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; font-size: 0.85rem; color: #f3f4f6; outline: none; transition: border-color 0.2s, box-shadow 0.2s; font-family: inherit; }
  .rpt-input:focus { border-color: #2563EB; box-shadow: 0 0 0 3px rgba(212,175,55,0.1); }
  .rpt-input option { background: #0a0e17; color: #f3f4f6; }
  .rpt-input-sm { width: auto; min-width: 120px; }
  .rpt-filter-btn { padding: 8px 20px; background: linear-gradient(135deg, #2563EB, #1D4ED8); color: #0a0e17; font-weight: 700; border: none; border-radius: 8px; font-size: 0.85rem; cursor: pointer; transition: all 0.2s; font-family: inherit; }
  .rpt-filter-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(212,175,55,0.3); }
  .rpt-table { width: 100%; border-collapse: collapse; }
  .rpt-table th { background: rgba(255,255,255,0.02); color: #6b7280; font-weight: 600; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; font-family: 'JetBrains Mono', monospace; padding: 10px 12px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.06); position: sticky; top: 0; z-index: 1; cursor: pointer; user-select: none; white-space: nowrap; }
  .rpt-table th .sort-arrow { color: #2563EB; font-size: 0.6rem; margin-left: 3px; }
  .rpt-table td { padding: 10px 12px; border-bottom: 1px solid rgba(255,255,255,0.04); color: #d1d5db; font-size: 0.82rem; white-space: nowrap; }
  .rpt-table tr:hover td { background: rgba(255,255,255,0.03); }
  /* los nombres de empresa son largos: que no estiren la tabla (el title tiene el valor completo) */
  .rpt-table td.col-empresa { max-width: 200px; overflow: hidden; text-overflow: ellipsis; }

  /* ===== CHECKLISTS MULTIPLES (Documento / Empresa) =====
     Son <select> reemplazados por un botón + panel con checkboxes: se pueden
     elegir varios a la vez. El panel se arma desde reports.js. */
  .vc-multi { position: relative; }
  .vc-multi-btn { display: inline-flex; align-items: center; justify-content: space-between; gap: 10px; text-align: left; cursor: pointer; font-weight: 500; }
  .vc-multi-caret { width: 0.85rem; height: 0.85rem; flex-shrink: 0; color: #6b7280; transition: transform 0.2s ease; }
  .vc-multi-btn[aria-expanded="true"] .vc-multi-caret { transform: rotate(180deg); }
  .vc-multi-panel { position: absolute; z-index: 40; top: calc(100% + 4px); left: 0; min-width: 100%; max-width: min(320px, 80vw); max-height: 280px; overflow-y: auto; background: #0d1220; border: 1px solid rgba(255,255,255,0.14); border-radius: 10px; box-shadow: 0 16px 40px rgba(0,0,0,0.55); padding: 5px; }
  .vc-multi-item { display: flex; align-items: center; gap: 8px; padding: 6px 9px; border-radius: 7px; font-size: 0.82rem; color: #d1d5db; cursor: pointer; white-space: nowrap; }
  .vc-multi-item:hover { background: rgba(255,255,255,0.07); }
  .vc-multi-item input { accent-color: #2563EB; width: 14px; height: 14px; cursor: pointer; flex-shrink: 0; }
  .vc-multi-sep { border-top: 1px solid rgba(255,255,255,0.09); margin: 4px 2px; }

  /* ===== AGRUPACION POR EMPRESA =====
     El destino real del reporte es la pizarra: encabezado de empresa grande,
     con cuántos vehículos y documentos mete, y cuántos ya vencieron. */
  .rpt-table tr.vc-grp td { background: rgba(212,175,55,0.09); border-top: 1px solid rgba(212,175,55,0.3); border-bottom: 1px solid rgba(212,175,55,0.18); padding: 9px 12px; }
  .rpt-table tr.vc-grp:hover td { background: rgba(212,175,55,0.09); }
  .vc-grp-nombre { font-weight: 800; font-size: 0.8rem; letter-spacing: 0.04em; color: #f3f4f6; }
  .vc-grp-count { font-weight: 500; font-size: 0.72rem; color: #9ca3af; }
  .vc-switch { display: inline-flex; align-items: center; gap: 7px; font-size: 0.78rem; font-weight: 600; color: #9ca3af; cursor: pointer; padding: 5px 10px; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; background: rgba(255,255,255,0.04); user-select: none; }
  .vc-switch:hover { background: rgba(255,255,255,0.08); color: #f3f4f6; }
  .vc-switch-box { accent-color: #2563EB; width: 14px; height: 14px; cursor: pointer; }
  .rpt-badge { font-size: 0.65rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 10px; }
  .filtro-chip { display: inline-flex; align-items: center; gap: 6px; background: rgba(212,175,55,0.1); border: 1px solid rgba(212,175,55,0.25); color: #2563EB; font-size: 0.72rem; font-weight: 600; padding: 3px 10px; border-radius: 999px; }
  .filtro-chip .x { cursor: pointer; color: #fca5a5; font-weight: 800; margin-left: 2px; }
  .filtro-chip .x:hover { color: #ef4444; }
  .col-legend { display: inline-flex; align-items: center; justify-content: center; gap: 2px; }

  /* ===== IMPRESIÓN DE VENCIMIENTOS =====
     Al imprimir solo sale la sección Vencimientos: sin sidebar, sin menús,
     sin los botones ni los selects de filtros, y la tabla sin scroll para
     que entre completa en varias páginas. Se activa con body.printing-venc.
     Vertical: la tabla tiene 5 columnas (patente, interno, tipo, empresa, vencimiento).
     Va con mucho contraste (negro sobre blanco, bordes gruesos, letra grande)
     porque el destino real es una pizarra: los grises claros y las letras
     chicas no se leen a distancia. */
  @media print {
    @page { size: portrait; margin: 12mm; }
  }
  body.printing-venc { background: #fff !important; }
  body.printing-venc aside,
  body.printing-venc #mobile-menu,
  body.printing-venc #mobile-menu-btn { display: none !important; }
  body.printing-venc main { overflow: visible !important; padding: 0 !important; }
  body.printing-venc .rpt-card:not(#sec-vencimientos) { display: none !important; }
  body.printing-venc #sec-vencimientos { border: none !important; background: #fff !important; box-shadow: none !important; padding: 0 !important; border-radius: 0 !important; }
  body.printing-venc #sec-vencimientos .rpt-glow::after { display: none !important; }
  /* la descripción larga de la web no aporta en la pizarra: el título va con los filtros */
  body.printing-venc #sec-vencimientos .rpt-desc { display: none !important; }
  body.printing-venc #sec-vencimientos h2 { color: #000 !important; font-size: 20pt !important; }
  body.printing-venc #sec-vencimientos #vc-subtitulo { color: #000 !important; font-size: 12pt !important; font-weight: 800 !important; margin-bottom: 6pt !important; }
  body.printing-venc #sec-vencimientos p { color: #000 !important; }
  body.printing-venc #sec-vencimientos .rpt-filters,
  body.printing-venc #sec-vencimientos .rpt-stat,
  body.printing-venc #sec-vencimientos .rpt-btn { display: none !important; }
  /* aunque esté contraída, al imprimir tiene que salir la tabla */
  body.printing-venc #sec-vencimientos > .rpt-body { display: block !important; }
  body.printing-venc #sec-vencimientos .overflow-x-auto { overflow: visible !important; max-height: none !important; border: none !important; }
  body.printing-venc .rpt-table th { background: #111827 !important; color: #fff !important; font-size: 10pt !important; font-weight: 800 !important; letter-spacing: 0.02em !important; padding: 6pt 5pt !important; position: static !important; border: 0.7pt solid #000 !important; }
  body.printing-venc .rpt-table td { color: #000 !important; font-size: 11pt !important; padding: 5pt !important; border: 0.5pt solid #000 !important; white-space: normal !important; }
  /* en la pizarra el nombre de la empresa tiene que leerse entero: sin recorte */
  body.printing-venc .rpt-table td.col-empresa { max-width: none !important; overflow: visible !important; text-overflow: clip !important; }
  body.printing-venc .rpt-table tr { page-break-inside: avoid; }
  /* las dos líneas chicas de la celda de vencimiento (días y tipo de documento) */
  body.printing-venc #sec-vencimientos .text-\[11px\] { font-size: 9.5pt !important; font-weight: 700 !important; }
  body.printing-venc #sec-vencimientos .text-\[10px\] { font-size: 9pt !important; font-weight: 700 !important; }
  body.printing-venc .rpt-table th .sort-arrow { display: none !important; }
  body.printing-venc .rpt-table tr:hover td { background: none !important; }
  /* el encabezado de empresa es lo que ordena el trabajo en la pizarra: letra grande */
  body.printing-venc .rpt-table tr.vc-grp td { background: #e2e8f0 !important; border-top: 1.2pt solid #000 !important; border-bottom: 0.5pt solid #000 !important; padding: 5pt !important; }
  body.printing-venc .rpt-table tr.vc-grp .vc-grp-nombre { font-size: 13pt !important; font-weight: 800 !important; color: #000 !important; }
  body.printing-venc .rpt-table tr.vc-grp .vc-grp-count { font-size: 10pt !important; font-weight: 700 !important; color: #000 !important; }
  body.printing-venc .text-red-400 { color: #b91c1c !important; }
  body.printing-venc .text-yellow-400 { color: #b45309 !important; }
  body.printing-venc .text-teal-300 { color: #0f766e !important; }
  body.printing-venc .text-\[\#8b9bb4\] { color: #000 !important; }
</style>
<div class="flex h-screen overflow-hidden">
  <%- include('partials/sidebar', { page: 'reports' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">
    <div class="lg:hidden header-glass text-[#f3f4f6] p-3 flex items-center justify-between">
      <button id="mobile-menu-btn" class="p-1 rounded hover:bg-[#2563EB]/10">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <span class="font-bold text-gradient-primary">Grupo Falpat SRL</span>
      <span class="w-8 h-8 bg-gradient-to-br from-[#2563EB] to-[#1D4ED8] rounded-full flex items-center justify-center text-sm font-bold text-white shadow-lg"><%= (currentUserData?.displayName || 'U').charAt(0).toUpperCase() %></span>
    </div>

    <main class="flex-1 overflow-y-auto p-4 md:p-6">
      <div class="rpt-hdr">
        <div class="rpt-ico rpt-ico-gold">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <div>
          <h1 class="text-xl font-extrabold title-page" style="letter-spacing:-0.01em">Reportes</h1>
          <p class="text-[#6b7280] text-sm">Filtros por cualquier campo · Exportación Excel / PDF</p>
        </div>
      </div>

      <!-- ============ SECCIÓN FLOTA ============ -->
      <div class="rpt-card rpt-glow mb-5 collapsed" id="sec-flota">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <button type="button" class="rpt-toggle" onclick="toggleSeccion('sec-flota')" aria-expanded="false" aria-controls="body-flota">
            <svg class="rpt-caret" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            <div class="rpt-ico rpt-ico-green">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a2 2 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
            </div>
            <div>
              <h2 class="text-lg font-extrabold title-page">Reporte de Flota</h2>
              <p class="text-[#6b7280] text-xs">Filtrá por cualquier campo (tipo → mixer, Nº BET, trompo, vencimientos…)</p>
            </div>
            <span class="rpt-hint"><span class="rpt-chip" id="chip-flota">cargando…</span></span>
          </button>
          <div class="flex flex-wrap items-center gap-1.5">
            <button onclick="guardarColumnas()" class="rpt-btn rpt-btn-gold" title="Elegir columnas de la tabla">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
              Columnas
            </button>
            <button onclick="exportFleetExcel()" class="rpt-btn">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              Excel
            </button>
            <button onclick="exportFleetPDF()" class="rpt-btn" style="border-color:rgba(239,68,68,0.3);color:#fca5a5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              PDF
            </button>
          </div>
        </div>

        <div class="rpt-body" id="body-flota">
        <div class="rpt-filters mb-3">
          <div class="flex flex-wrap items-end gap-2 flex-1">
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Buscar en todo</label>
              <input type="text" id="fv-buscar" class="rpt-input" style="min-width:180px" placeholder="Patente, interno, chofer…" oninput="setFleetSearch(this.value)">
            </div>
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Campo</label>
              <select id="fv-campo" class="rpt-input rpt-input-sm" style="min-width:170px" onchange="cambiarCampoFiltro()"></select>
            </div>
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Condición</label>
              <select id="fv-oper" class="rpt-input rpt-input-sm" style="min-width:130px"></select>
            </div>
            <div class="flex flex-col" id="fv-valor-wrap">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Valor</label>
              <input type="text" id="fv-valor" class="rpt-input rpt-input-sm" style="min-width:150px" placeholder="Valor…">
            </div>
            <div class="flex flex-col justify-end">
              <button onclick="agregarFiltro()" class="rpt-filter-btn flex items-center gap-1.5">+ Filtro</button>
            </div>
            <div class="flex flex-col justify-end">
              <button onclick="limpiarFiltrosFlota()" class="rpt-btn"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>Limpiar</button>
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-1.5" id="fv-chips"></div>
        </div>

        <div id="fv-columnas" class="hidden mb-3" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:1rem 1.25rem;">
          <div class="flex items-center justify-between flex-wrap gap-2 mb-2">
            <span class="text-xs font-bold text-[#f3f4f6]">Columnas visibles</span>
            <div class="flex gap-1.5">
              <button onclick="setColumnas('frecuentes')" class="rpt-btn">Solo frecuentes</button>
              <button onclick="setColumnas('todas')" class="rpt-btn">Todas</button>
            </div>
          </div>
          <div id="fv-columnas-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-1.5"></div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Resultado filtro</p><p class="text-xl font-bold text-[#f3f4f6] mt-1" id="fv-resultados">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Trompo</p><p class="text-xl font-bold text-[#2563EB] mt-1" id="fv-trompo">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Mixers</p><p class="text-xl font-bold text-[#2563EB] mt-1" id="fv-mixers">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Con Nº BET</p><p class="text-xl font-bold text-[#2563EB] mt-1" id="fv-bet">-</p></div>
        </div>

        <div class="overflow-x-auto max-h-[520px] overflow-y-auto rounded-lg" style="border:1px solid rgba(255,255,255,0.06)">
          <table class="rpt-table">
            <thead id="fv-thead"></thead>
            <tbody id="fv-tbody"></tbody>
          </table>
          <div id="fv-vacio" class="hidden text-center py-10 text-[#4a5568] text-sm">Sin resultados para los filtros aplicados</div>
        </div>
        </div>
      </div>

      <!-- ============ SECCIÓN DOCUMENTACIÓN ============ -->
      <div class="rpt-card rpt-glow collapsed" id="sec-documentacion">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <button type="button" class="rpt-toggle" onclick="toggleSeccion('sec-documentacion')" aria-expanded="false" aria-controls="body-documentacion">
            <svg class="rpt-caret" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            <div class="rpt-ico rpt-ico-purple">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V19a1 1 0 01-2 2z"/></svg>
            </div>
            <div>
              <h2 class="text-lg font-extrabold title-page">Documentación</h2>
              <p class="text-[#6b7280] text-xs">Estado de Título, Cédula, Seguro, Registro, VTV y DNI por vehículo</p>
            </div>
            <span class="rpt-hint"><span class="rpt-chip" id="chip-documentacion">cargando…</span></span>
          </button>
          <div class="flex flex-wrap items-center gap-1.5">
            <button onclick="exportDocExcel()" class="rpt-btn">

              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              Excel
            </button>
            <button onclick="exportDocPDF()" class="rpt-btn" style="border-color:rgba(239,68,68,0.3);color:#fca5a5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              PDF
            </button>
          </div>
        </div>

        <div class="rpt-body" id="body-documentacion">
        <div class="rpt-filters mb-3">
          <div class="flex flex-wrap items-end gap-2 flex-1">
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Buscar</label>
              <input type="text" id="fd-buscar" class="rpt-input" style="min-width:160px" placeholder="Patente, marca…" oninput="setDocSearch(this.value)">
            </div>
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Falta documento</label>
              <select id="fd-doc" class="rpt-input rpt-input-sm" onchange="setDocFalta(this.value)">
                <option value="">Todos</option>
              </select>
            </div>
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Estado</label>
              <select id="fd-estado" class="rpt-input rpt-input-sm" onchange="setDocEstado(this.value)">
                <option value="todos">Todos</option>
                <option value="completos">Completos</option>
                <option value="faltantes">Con faltantes</option>
              </select>
            </div>
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Empresa</label>
              <select id="fd-empresa" class="rpt-input rpt-input-sm" onchange="setDocEmpresa(this.value)"></select>
            </div>
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Centro de trabajo</label>
              <select id="fd-centro" class="rpt-input rpt-input-sm" onchange="setDocCentro(this.value)"></select>
            </div>
            <div class="flex flex-col justify-end">
              <button onclick="limpiarFiltrosDoc()" class="rpt-btn"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>Limpiar</button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Vehículos</p><p class="text-xl font-bold text-[#f3f4f6] mt-1" id="doc-total">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Completos</p><p class="text-xl font-bold text-[#00E5FF] mt-1" id="doc-completos">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Con faltantes</p><p class="text-xl font-bold text-red-400 mt-1" id="doc-faltantes-count">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Docs faltantes</p><p class="text-xl font-bold text-[#2563EB] mt-1" id="doc-total-faltantes">-</p></div>
        </div>

        <div class="overflow-x-auto max-h-[520px] overflow-y-auto rounded-lg" style="border:1px solid rgba(255,255,255,0.06)">
          <table class="rpt-table">
            <thead id="doc-thead"></thead>
            <tbody id="doc-table"></tbody>
          </table>
          <div id="doc-vacio" class="hidden text-center py-10 text-[#4a5568] text-sm">Sin resultados para los filtros aplicados</div>
        </div>
        </div>
      </div>

      <!-- ============ SECCIÓN VENCIMIENTOS ============ -->
      <div class="rpt-card rpt-glow collapsed" id="sec-vencimientos">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <button type="button" class="rpt-toggle" onclick="toggleSeccion('sec-vencimientos')" aria-expanded="false" aria-controls="body-vencimientos">
            <svg class="rpt-caret" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            <div class="rpt-ico rpt-ico-gold">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <h2 class="text-lg font-extrabold title-page">Vencimientos</h2>
              <p class="rpt-desc text-[#6b7280] text-xs">Qué está por vencer o ya venció: VTV, Seguro, Service, Matafuego, DNI, Registro y Cédula</p>
              <p class="text-[#6b7280] text-xs font-semibold mt-0.5" id="vc-subtitulo">&nbsp;</p>
            </div>
            <span class="rpt-hint"><span class="rpt-chip" id="chip-vencimientos">cargando…</span></span>
          </button>
          <div class="flex flex-wrap items-center gap-1.5">
            <button onclick="exportVencExcel()" class="rpt-btn">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              Excel
            </button>
            <button onclick="exportVencPDF()" class="rpt-btn" style="border-color:rgba(239,68,68,0.3);color:#fca5a5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              PDF
            </button>
            <button onclick="printVenc()" class="rpt-btn rpt-btn-gold">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z"/></svg>
              Imprimir
            </button>
          </div>
        </div>

        <div class="rpt-body" id="body-vencimientos">
        <div class="rpt-filters mb-3">
          <div class="flex flex-wrap items-end gap-2 flex-1">
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Buscar</label>
              <input type="text" id="vc-buscar" class="rpt-input" style="min-width:150px" placeholder="Patente, interno…" oninput="setVencSearch(this.value)">
            </div>
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Vence en</label>
              <select id="vc-ventana" class="rpt-input rpt-input-sm" onchange="setVencVentana(this.value)">
                <option value="7">7 días</option>
                <option value="15">15 días</option>
                <option value="30" selected>30 días</option>
                <option value="60">60 días</option>
                <option value="90">90 días</option>
                <option value="180">180 días</option>
                <option value="365">1 año</option>
                <option value="99999">Sin límite</option>
              </select>
            </div>
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Documento</label>
              <div class="vc-multi">
                <button type="button" class="rpt-input rpt-input-sm vc-multi-btn" onclick="toggleMultiVenc('doc')" aria-expanded="false" aria-haspopup="true">
                  <span id="vc-doc-label">Todos</span>
                  <svg class="vc-multi-caret" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div class="vc-multi-panel hidden" id="vc-doc-panel"></div>
              </div>
            </div>
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Estado</label>
              <select id="vc-estado" class="rpt-input rpt-input-sm" onchange="setVencEstado(this.value)">
                <option value="todos">Todos</option>
                <option value="vencidos">Ya vencidos</option>
                <option value="proximos">Por vencer</option>
                <option value="15">Vencen en 15 días</option>
              </select>
            </div>
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Empresa</label>
              <div class="vc-multi">
                <button type="button" class="rpt-input rpt-input-sm vc-multi-btn" onclick="toggleMultiVenc('emp')" aria-expanded="false" aria-haspopup="true">
                  <span id="vc-empresa-label">Todas</span>
                  <svg class="vc-multi-caret" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div class="vc-multi-panel hidden" id="vc-empresa-panel"></div>
              </div>
            </div>
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Centro de trabajo</label>
              <select id="vc-centro" class="rpt-input rpt-input-sm" onchange="setVencCentro(this.value)"></select>
            </div>
            <div class="flex flex-col">
              <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Tipo</label>
              <select id="vc-tipo" class="rpt-input rpt-input-sm" onchange="setVencTipo(this.value)"></select>
            </div>
            <div class="flex flex-col justify-end">
              <label class="vc-switch" title="Agrupa el informe por empresa, de la más urgente a la menos urgente">
