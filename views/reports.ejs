                <span>Agrupar por empresa</span>
              </label>
            </div>
            <div class="flex flex-col justify-end">
              <button onclick="limpiarFiltrosVenc()" class="rpt-btn"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>Limpiar</button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Vehículos</p><p class="text-xl font-bold text-[#f3f4f6] mt-1" id="vc-total">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Vencidos</p><p class="text-xl font-bold text-red-400 mt-1" id="vc-vencidos">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">≤ 15 días</p><p class="text-xl font-bold text-yellow-400 mt-1" id="vc-15">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Docs a vencer</p><p class="text-xl font-bold text-[#2563EB] mt-1" id="vc-docs">-</p></div>
        </div>

        <div class="overflow-x-auto max-h-[520px] overflow-y-auto rounded-lg" style="border:1px solid rgba(255,255,255,0.06)">
          <table class="rpt-table">
            <thead id="vc-thead"></thead>
            <tbody id="vc-table"></tbody>
          </table>
          <div id="vc-vacio" class="hidden text-center py-10 text-[#4a5568] text-sm">Sin vencimientos para los filtros aplicados</div>
        </div>
        </div>
      </div>

    </main>
  </div>
</div>

