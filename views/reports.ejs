<%- include('partials/head') %>
<style>
  /* ===== GLAMOURS-INSPIRED REPORT STYLES ===== */
  .report-tab { padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 600; color: #9ca3af; background: transparent; border: 1px solid rgba(255,255,255,0.08); white-space: nowrap; transition: all 0.2s; cursor: pointer; }
  .report-tab:hover { background: rgba(255,255,255,0.05); color: #f3f4f6; border-color: rgba(255,255,255,0.15); }
  .report-tab.active { background: rgba(212,175,55,0.12); color: #d4af37; border-color: rgba(212,175,55,0.35); font-weight: 700; }
  .rpt-card { background: linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.015) 100%); border: 1px solid rgba(255,255,255,0.08); border-radius: 18px; padding: 1.5rem; box-shadow: 0 16px 40px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.07); position: relative; overflow: hidden; transition: border-color 0.3s; }
  .rpt-card:hover { border-color: rgba(255,255,255,0.15); }
  .rpt-glow::after { content: ''; position: absolute; top: -50px; right: -50px; width: 170px; height: 170px; border-radius: 50%; background: radial-gradient(circle, rgba(212,175,55,0.12) 0%, transparent 70%); pointer-events: none; }
  .rpt-hdr { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .rpt-ico { width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .rpt-ico-gold { background: linear-gradient(135deg, #d4af37, #b8960c); box-shadow: 0 8px 20px rgba(212,175,55,0.25); }
  .rpt-ico-green { background: linear-gradient(135deg, #065f46, #047857); }
  .rpt-ico-purple { background: linear-gradient(135deg, #7e22ce, #9333ea); }
  .rpt-filters { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 1rem 1.25rem; }
  .rpt-hero { background: linear-gradient(135deg, #854d0e 0%, #a16207 40%, #ca8a04 100%); border: 1px solid rgba(212,175,55,0.3); border-radius: 16px; padding: 1.75rem 2rem; position: relative; overflow: hidden; box-shadow: 0 16px 40px rgba(202,138,4,0.18); }
  .rpt-btn { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #9ca3af; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s; white-space: nowrap; font-family: inherit; }
  .rpt-btn:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); color: #f3f4f6; }
  .rpt-stat { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; padding: 1.25rem; position: relative; overflow: hidden; transition: all 0.3s; }
  .rpt-stat::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, #d4af37, #b8960c); opacity: 0.6; }
  .rpt-stat:hover { border-color: rgba(255,255,255,0.12); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
  .rpt-qr { padding: 4px 10px; font-size: 11px; color: #9ca3af; background: transparent; border: 1px solid transparent; border-radius: 8px; cursor: pointer; transition: all 0.15s; font-weight: 500; font-family: inherit; }
  .rpt-qr:hover { color: #d4af37; background: rgba(212,175,55,0.08); border-color: rgba(212,175,55,0.2); }
  .rpt-div { border-top: 2px solid rgba(212,175,55,0.15); margin: 1rem 0; }
  .rpt-input { width: 100%; padding: 8px 12px; background: rgba(12,16,26,0.5); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; font-size: 0.85rem; color: #f3f4f6; outline: none; transition: border-color 0.2s, box-shadow 0.2s; font-family: inherit; }
  .rpt-input:focus { border-color: #d4af37; box-shadow: 0 0 0 3px rgba(212,175,55,0.1); }
  .rpt-input option { background: #0a0e17; color: #f3f4f6; }
  .rpt-filter-btn { padding: 8px 20px; background: linear-gradient(135deg, #d4af37, #b8960c); color: #0a0e17; font-weight: 700; border: none; border-radius: 8px; font-size: 0.85rem; cursor: pointer; transition: all 0.2s; font-family: inherit; }
  .rpt-filter-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(212,175,55,0.3); }
  .rpt-table { width: 100%; border-collapse: collapse; }
  .rpt-table th { background: rgba(255,255,255,0.02); color: #6b7280; font-weight: 600; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; font-family: 'JetBrains Mono', monospace; padding: 10px 12px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.06); position: sticky; top: 0; z-index: 1; }
  .rpt-table td { padding: 10px 12px; border-bottom: 1px solid rgba(255,255,255,0.04); color: #d1d5db; font-size: 0.82rem; }
  .rpt-table tr:hover td { background: rgba(255,255,255,0.03); }
  .rpt-tfoot td { border-top: 2px solid rgba(212,175,55,0.2) !important; font-weight: 700; }
  .rpt-badge { font-size: 0.65rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 10px; }
</style>
<div class="flex h-screen overflow-hidden">
  <%- include('partials/sidebar', { page: 'reports' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">
    <div class="lg:hidden header-glass text-[#f3f4f6] p-3 flex items-center justify-between">
      <button id="mobile-menu-btn" class="p-1 rounded hover:bg-[#d4af37]/10">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <span class="font-bold text-gradient-primary">Grupo Falpat SRL</span>
      <span class="w-8 h-8 bg-gradient-to-br from-[#d4af37] to-[#b8960c] rounded-full flex items-center justify-center text-sm font-bold text-white shadow-lg"><%= (currentUserData?.displayName || 'U').charAt(0).toUpperCase() %></span>
    </div>

    <main class="flex-1 overflow-y-auto p-4 md:p-6">
      <div class="rpt-hdr">
        <div class="rpt-ico rpt-ico-gold">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <div>
          <h1 class="text-xl font-extrabold text-[#f3f4f6]" style="letter-spacing:-0.01em">Reportes</h1>
          <p class="text-[#6b7280] text-sm">Análisis financiero por sección</p>
        </div>
      </div>

      <div class="rpt-filters mb-4">
        <div class="flex items-center gap-3 flex-1 flex-wrap">
          <svg class="w-4 h-4 text-[#d4af37] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
          <div class="flex flex-col">
            <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Desde</label>
            <input type="date" id="filtro-desde" class="rpt-input" style="min-width:140px">
          </div>
          <div class="flex flex-col">
            <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Hasta</label>
            <input type="date" id="filtro-hasta" class="rpt-input" style="min-width:140px">
          </div>
          <div class="flex flex-col">
            <label class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mb-1">Vehículo</label>
            <select id="filtro-vehiculo" class="rpt-input" style="min-width:180px">
              <option value="todos">Todos</option>
            </select>
          </div>
          <div class="flex flex-col justify-end">
            <button onclick="applyFilters()" class="rpt-filter-btn flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              Filtrar
            </button>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-[10px] font-semibold text-[#6b7280] uppercase tracking-wider mr-1">Rápido:</span>
          <button onclick="setDateRange('month')" class="rpt-qr">Este mes</button>
          <button onclick="setDateRange('quarter')" class="rpt-qr">Trimestre</button>
          <button onclick="setDateRange('year')" class="rpt-qr">Este año</button>
          <button onclick="setDateRange('last3')" class="rpt-qr">Últimos 3 meses</button>
          <button onclick="setDateRange('last6')" class="rpt-qr">Últimos 6 meses</button>
          <button onclick="setDateRange('all')" class="rpt-qr">Todo</button>
        </div>
      </div>

      <div class="flex gap-1.5 mb-4 overflow-x-auto pb-1 -mx-1 px-1">
        <button onclick="switchTab('resumen')" data-tab="resumen" class="report-tab active">
          <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          Resumen
        </button>
        <button onclick="switchTab('combustible')" data-tab="combustible" class="report-tab">
          <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/></svg>
          Combustible
        </button>
        <button onclick="switchTab('repuestos')" data-tab="repuestos" class="report-tab">
          <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Repuestos
        </button>
        <button onclick="switchTab('vtv')" data-tab="vtv" class="report-tab">
          <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          VTV
        </button>
        <button onclick="switchTab('seguro')" data-tab="seguro" class="report-tab">
          <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Seguro
        </button>
        <button onclick="switchTab('vehiculos')" data-tab="vehiculos" class="report-tab">
          <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a2 2 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
          Vehículos
        </button>
        <button onclick="switchTab('empresas')" data-tab="empresas" class="report-tab">
          <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          Empresas
        </button>
        <button onclick="switchTab('costovehiculo')" data-tab="costovehiculo" class="report-tab">
          <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Costo/Vehículo
        </button>
        <button onclick="switchTab('documentacion')" data-tab="documentacion" class="report-tab">
          <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Documentación
        </button>
      </div>

      <div id="tab-resumen" class="report-section">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Combustible</p><p class="text-xl font-bold text-[#f3f4f6] mt-1" id="res-total-comb">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Repuestos</p><p class="text-xl font-bold text-[#f3f4f6] mt-1" id="res-total-rep">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">VTV</p><p class="text-xl font-bold text-[#f3f4f6] mt-1" id="res-total-vtv">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider font-medium">Seguro</p><p class="text-xl font-bold text-[#f3f4f6] mt-1" id="res-total-seg">-</p></div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="rpt-card rpt-glow">
            <h3 class="text-sm font-semibold text-[#f3f4f6] mb-3 flex items-center gap-2 relative"><svg class="w-4 h-4 text-[#d4af37]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/></svg>Gastos por Categoría</h3>
            <div class="flex items-center justify-center h-[220px]"><canvas id="chart-donut" height="220"></canvas></div>
          </div>
          <div class="rpt-card rpt-glow">
            <h3 class="text-sm font-semibold text-[#f3f4f6] mb-3 flex items-center gap-2 relative"><svg class="w-4 h-4 text-[#d4af37]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>Top 10 Vehículos (Gasto Total)</h3>
            <div class="flex items-center justify-center h-[220px]"><canvas id="chart-top-vehicles" height="220"></canvas></div>
          </div>
        </div>
        <div class="rpt-card rpt-glow mt-4">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-semibold text-[#f3f4f6] flex items-center gap-2"><svg class="w-4 h-4 text-[#d4af37]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>Detalle de Gastos</h3>
            <span class="text-[#6b7280] text-xs" id="res-count">0 registros</span>
          </div>
          <div class="overflow-x-auto max-h-[350px] overflow-y-auto">
            <table class="w-full text-sm">
              <thead class="sticky top-0"><tr class="text-left text-[#6b7280] border-b border-white/[0.06]">
                <th class="pb-2 pr-3 font-medium text-xs">Fecha</th>
                <th class="pb-2 pr-3 font-medium text-xs">Cat.</th>
                <th class="pb-2 pr-3 font-medium text-xs">Vehículo</th>
                <th class="pb-2 pr-3 font-medium text-xs">Detalle</th>
                <th class="pb-2 text-right font-medium text-xs">Monto</th>
              </tr></thead>
              <tbody id="res-table"></tbody>
              <tfoot id="res-foot" class="hidden"><tr class="border-t border-white/[0.08]"><td colspan="4" class="pt-2 pr-3 text-right text-[#6b7280] text-xs font-medium">Total:</td><td class="pt-2 text-right text-[#f3f4f6] font-bold text-sm" id="res-grand-total">$ 0</td></tr></tfoot>
            </table>
          </div>
          <div class="flex gap-2 mt-3 justify-end">
            <button onclick="exportSectionExcel('resumen')" class="rpt-btn">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              Excel
            </button>
            <button onclick="exportSectionPDF('resumen')" class="rpt-btn" style="border-color:rgba(239,68,68,0.3);color:#fca5a5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              PDF
            </button>
          </div>
        </div>
      </div>

      <div id="tab-combustible" class="report-section hidden">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4">
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider">Total Litros</p><p class="text-xl font-bold text-[#f3f4f6]" id="comb-litros">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider">Total Importe</p><p class="text-xl font-bold text-[#f3f4f6]" id="comb-importe">-</p></div>
          <div class="rpt-stat"><p class="text-[#6b7280] text-[11px] uppercase tracking-wider">Precio Promedio/L</p><p class="text-xl font-bold text-[#f3f4f6]" id="comb-promedio">-</p></div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-4">
          <div class="lg:col-span-2 rpt-card rpt-glow">
            <h3 class="text-sm font-semibold text-[#f3f4f6] mb-3 flex items-center gap-2 relative"><svg class="w-4 h-4 text-[#d4af37]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>Evolución Mensual</h3>
            <div class="h-[220px]"><canvas id="chart-comb-mensual" height="220"></canvas></div>
