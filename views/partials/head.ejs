<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <title><%= title %> - Grupo Falpat SRL</title>
  <% if (mockMode) { %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <% } else { %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-storage-compat.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <meta name="theme-color" content="#0b0e14">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/themes.css?v=<%= (typeof assetV !== 'undefined' ? assetV : 'dev') %>">
  <script>
    // Aplica el tema ANTES de pintar para evitar el destello blanco/negro inicial
    (function () {
      try {
        var t = localStorage.getItem('falpat_theme') || 'pro';
        document.documentElement.setAttribute('data-theme', t);
        var d = localStorage.getItem('falpat_density');
        if (d) document.addEventListener('DOMContentLoaded', function () {
          document.body.setAttribute('data-density', d);
        });
        if (t === 'claro' || (t === 'auto' && matchMedia('(prefers-color-scheme: light)').matches)) {
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.content = '#f1f5f9';
        }
      } catch (e) { document.documentElement.setAttribute('data-theme', 'pro'); }
      // El sidebar se colapsa antes del primer pintado (evita el "salto" de ancho)
      try {
        var nv = localStorage.getItem('falpat_nav');
        if (nv) document.addEventListener('DOMContentLoaded', function () {
          document.body.setAttribute('data-nav', nv);
        });
      } catch (e) {}
    })();
  </script>
<script src="/js/theme.js?v=<%= (typeof assetV !== 'undefined' ? assetV : 'dev') %>" defer></script>
<script src="/js/clock.js?v=<%= (typeof assetV !== 'undefined' ? assetV : 'dev') %>" defer></script>
<script src="/js/command-palette.js?v=<%= (typeof assetV !== 'undefined' ? assetV : 'dev') %>" defer></script>
  <script>window.__IS_ADMIN = <%= (currentUserData?.role === 'Admin') %>;</script>
</head>
<body>
