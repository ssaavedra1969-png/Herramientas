<%
const currentPage = typeof page !== 'undefined' ? page : '';
const isAdmin = currentUserData?.role === 'Admin';
const userName = currentUserData?.displayName || currentUser?.email?.split('@')[0] || 'Usuario';
const userInitial = userName.charAt(0).toUpperCase();
%>

<aside id="sidebar" class="sidebar hidden lg:flex">
  <% if (clientConfig?.devReadOnly) { %>
  <div class="mx-3 mt-3 px-3 py-2 rounded-md bg-[#F59E0B]/15 border border-[#F59E0B]/30 text-center">
    <p class="text-[#F59E0B] text-[10px] font-bold uppercase tracking-widest">Solo lectura</p>
  </div>
  <% } %>

  <!-- Marca + colapso -->
  <div class="flex items-center gap-3 h-[60px] px-4 flex-shrink-0 hairline-b">
    <img src="/images/fp3d.png" class="w-8 h-8 object-contain flex-shrink-0" alt="Grupo Falpat">
    <span class="nav-label font-display font-bold text-[15px] tracking-tight t-strong whitespace-nowrap">Falpat <span class="t-subtle font-semibold">SRL</span></span>
    <button type="button" onclick="toggleNav()" class="nav-toggle ml-auto" title="Colapsar menu" aria-label="Colapsar menu">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7M18 19l-7-7 7-7"/></svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto overflow-x-hidden py-3 px-3 space-y-0.5">
    <span class="nav-sec">Operación</span>
    <a href="/dashboard" class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>" title="Dashboard">
      <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
      <span class="nav-label">Dashboard</span>
      <span id="alert-badge" class="nav-badge hidden"></span>
    </a>
    <a href="/vehicles" class="nav-link <%= currentPage === 'vehicles' ? 'active' : '' %>" title="Vehículos">
      <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 9.75l-2.25-2.25-2.25 2.25m6 0l2.25 2.25"/></svg>
      <span class="nav-label">Vehículos</span>
    </a>
    <a href="/service" class="nav-link <%= currentPage === 'service' ? 'active' : '' %>" title="Service">
      <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.658 5.658a2 2 0 01-2.83 0l-1.586-1.586a2 2 0 010-2.83l5.658-5.658m7.5-3.365a2.25 2.25 0 103.935 2.535 8.72 8.72 0 003.935-2.535m0 0l-3.935-2.535a8.72 8.72 0 00-3.935-2.535m-12.79 6.11A2.25 2.25 0 009.75 15.17m8.79-10.41a2.25 2.25 0 001.013 2.592M7.5 21.75a2.25 2.25 0 01-3-3m3 3a2.25 2.25 0 00-3-3m0 0l3-3"/></svg>
      <span class="nav-label">Service</span>
      <span id="service-badge" class="nav-badge hidden"></span>
    </a>
    <a href="/centros" class="nav-link <%= currentPage === 'centros' ? 'active' : '' %>" title="Centros de Trabajo">
      <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/></svg>
      <span class="nav-label">Centros</span>
    </a>

    <span class="nav-sec">Análisis</span>
    <a href="/reports" class="nav-link <%= currentPage === 'reports' ? 'active' : '' %>" title="Reportes">
      <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/></svg>
      <span class="nav-label">Reportes</span>
    </a>

    <span class="nav-sec">Utilidades</span>
    <a href="/vehicle/scan" class="nav-link <%= currentPage === 'scan' ? 'active' : '' %>" title="Escáner QR">
      <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 7.5V6a2.25 2.25 0 012.25-2.25h1.5m9 0h1.5a2.25 2.25 0 012.25 2.25v1.5m0 9v1.5a2.25 2.25 0 01-2.25 2.25h-1.5m-9 0h-1.5A2.25 2.25 0 013 19.5V18m0-9.75h3v3H3v-3zm15 0h3v3h-3v-3zm-15 9h3v3H3v-3zm15 0h3v3h-3v-3z"/></svg>
      <span class="nav-label">Escáner QR</span>
    </a>
    <% if (isAdmin) { %>
    <a href="/vehicles/qr-stickers-bulk" target="_blank" class="nav-link <%= currentPage === 'stickers' ? 'active' : '' %>" title="Stickers QR">
      <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.513 1.96 3 3 0 001.1 3.696 3 3 0 001.1 1.128m0 0a3 3 0 105.78 1.128 2.25 2.25 0 002.513 1.96 3 3 0 00-1.1-3.696 3 3 0 00-1.1-1.128m0 0a3 3 0 10-5.78-1.128 2.25 2.25 0 00-2.513-1.96 3 3 0 001.1-3.696 3 3 0 001.1-1.128"/></svg>
      <span class="nav-label">Stickers QR</span>
    </a>
    <a href="/vehicles/fichas-taller-bulk" target="_blank" class="nav-link <%= currentPage === 'fichas' ? 'active' : '' %>" title="Fichas Taller">
      <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
      <span class="nav-label">Fichas Taller</span>
    </a>
    <a href="/vehicles/carpeta-docs" target="_blank" class="nav-link <%= currentPage === 'carpeta' ? 'active' : '' %>" title="Carpeta Docs">
      <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z"/></svg>
      <span class="nav-label">Carpeta Docs</span>
    </a>
    <span class="nav-sec">Administración</span>
    <a href="/admin" class="nav-link <%= currentPage === 'admin' ? 'active' : '' %>" title="Usuarios">
      <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
      <span class="nav-label">Usuarios</span>
    </a>
    <% } %>
  </nav>

  <!-- Usuario -->
  <div class="px-3 py-3 hairline-t flex-shrink-0">
    <div class="flex items-center gap-2.5 px-2 py-1.5 mb-1">
      <div class="w-8 h-8 rounded-full grid place-items-center bg-[#2563EB] text-white text-[13px] font-bold flex-shrink-0"><%= userInitial %></div>
      <div class="user-meta min-w-0 flex-1">
        <p class="text-[13px] font-semibold t-strong truncate leading-tight"><%= userName %></p>
        <p class="text-[11px] t-subtle leading-tight"><%= currentUserData?.role || '' %></p>
      </div>
    </div>
    <button onclick="handleLogout()" class="nav-link w-full text-[#EF4444]" title="Cerrar sesión">
      <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/></svg>
      <span class="nav-label">Cerrar sesión</span>
    </button>
  </div>
</aside>

<script>
  window.toggleNav = window.toggleNav || function () {
    var next = document.body.getAttribute('data-nav') === 'collapsed' ? 'expanded' : 'collapsed';
    document.body.setAttribute('data-nav', next);
    try { localStorage.setItem('falpat_nav', next); } catch (e) {}
  };
  // Restaura la preferencia de colapso antes del primer pintado
  try {
    var nav = localStorage.getItem('falpat_nav');
    if (nav) document.body.setAttribute('data-nav', nav);
  } catch (e) {}
</script>
