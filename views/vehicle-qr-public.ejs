<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vehículo — <%= vehicle.patente || vehicle.interno || 'QR' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
  <style>
    * { -webkit-tap-highlight-color: transparent; }
    body { background: linear-gradient(135deg, #0a0e17 0%, #1a1a3e 50%, #0a0e17 100%); min-height: 100vh; min-height: 100dvh; }
    .glass-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(212,175,55,0.15); backdrop-filter: blur(12px); }
    .text-gradient-primary { background: linear-gradient(135deg, #d4af37, #d4af37); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .admin-bar { position: sticky; top: 0; z-index: 50; background: rgba(10,10,26,0.95); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(212,175,55,0.2); }
    .status-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 9999px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .btn-primary { background: linear-gradient(135deg, #d4af37, #d4af37); color: #fff; padding: 10px 20px; border-radius: 12px; font-weight: 700; font-size: 14px; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; }
    .btn-primary:active { transform: scale(0.97); opacity: 0.9; }
    .btn-secondary { background: rgba(255,255,255,0.08); color: #ffffff; padding: 10px 20px; border-radius: 12px; font-weight: 600; font-size: 14px; border: 1px solid rgba(255,255,255,0.1); cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; }
    .btn-secondary:active { background: rgba(255,255,255,0.15); }
    .login-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(10,10,26,0.97); display: flex; align-items: center; justify-content: center; padding: 16px; }
    .login-overlay.hidden { display: none; }
    .input-field { width: 100%; padding: 12px 16px; background: rgba(255,255,255,0.06); border: 1px solid rgba(212,175,55,0.25); border-radius: 10px; color: #ffffff; font-size: 16px; outline: none; }
    .input-field:focus { border-color: #d4af37; box-shadow: 0 0 0 2px rgba(212,175,55,0.2); }
    .input-field::placeholder { color: #4a5568; }
  </style>
</head>
<body class="text-[#ffffff]">

  <div class="p-4 pb-8">
    <div class="max-w-lg mx-auto">

      <div class="flex items-center gap-3 mb-5">
        <div class="w-11 h-11 bg-gradient-to-br from-[#b8960c] to-[#d4af37] rounded-xl flex items-center justify-center shadow-lg shadow-[#d4af37]/30 flex-shrink-0 p-1.5">
          <img src="/images/fp3d.png" class="w-full h-full object-contain" alt="Logo Grupo Falpat">
        </div>
        <div class="flex-1">
          <h1 class="text-lg font-bold text-gradient-primary">Grupo Falpat SRL</h1>
          <p class="text-[#8b9bb4] text-[11px]">Control de Mantenimiento</p>
        </div>
        <a href="/login" class="flex-shrink-0 px-3 py-2 bg-white/5 hover:bg-white/10 rounded-lg text-[#8b9bb4] text-[11px] font-medium transition border border-white/10 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
          Admin
        </a>
      </div>

      <div class="glass-card rounded-2xl p-4 sm:p-5 mb-3">
        <div class="flex items-center justify-between mb-2">
          <div>
            <p class="text-[#8b9bb4] text-[10px] uppercase tracking-wider">Patente</p>
            <p class="text-2xl sm:text-3xl font-black text-[#ffffff] tracking-wider leading-tight"><%= vehicle.patente || '—' %></p>
          </div>
          <div class="text-right">
            <p class="text-[#8b9bb4] text-[10px] uppercase tracking-wider">Interno</p>
            <p class="text-xl sm:text-2xl font-bold text-gradient-primary"><%= vehicle.interno || '—' %></p>
          </div>
        </div>

        <% const ec = vehicle.estadoGeneral === 'Bueno' ? 'bg-green-500/20 text-green-400' : vehicle.estadoGeneral === 'Regular' ? 'bg-yellow-500/20 text-yellow-400' : vehicle.estadoGeneral === 'Malo' ? 'bg-red-500/20 text-red-400' : 'bg-gray-500/20 text-gray-400'; %>
        <div class="mb-2">
          <span class="status-badge <%= ec %>"><%= vehicle.estadoGeneral || 'Sin estado' %></span>
        </div>

        <div class="h-px bg-[#d4af37]/15 my-3"></div>
        <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
          <div><p class="text-[#8b9bb4] text-[10px]">Marca</p><p class="font-semibold text-[#ffffff]"><%= vehicle.marca || '—' %></p></div>
          <div><p class="text-[#8b9bb4] text-[10px]">Modelo</p><p class="font-semibold text-[#ffffff]"><%= vehicle.modelo || '—' %></p></div>
          <div><p class="text-[#8b9bb4] text-[10px]">Tipo</p><p class="font-semibold text-[#ffffff]"><%= vehicle.tipo || '—' %></p></div>
          <div><p class="text-[#8b9bb4] text-[10px]">Año</p><p class="font-semibold text-[#ffffff]"><%= vehicle.año || '—' %></p></div>
          <% if (vehicle.subtipo) { %><div><p class="text-[#8b9bb4] text-[10px]">Subtipo</p><p class="font-semibold text-[#ffffff]"><%= vehicle.subtipo %></p></div><% } %>
          <% if (vehicle.marca !== vehicle.marcaChasis && vehicle.marcaChasis) { %><div><p class="text-[#8b9bb4] text-[10px]">Marca Chasis</p><p class="font-semibold text-[#ffffff]"><%= vehicle.marcaChasis %></p></div><% } %>
          <% if (vehicle.chasis) { %><div><p class="text-[#8b9bb4] text-[10px]">Chasis</p><p class="font-semibold text-[#ffffff]"><%= vehicle.chasis %></p></div><% } %>
          <% if (vehicle.numeroMotor) { %><div><p class="text-[#8b9bb4] text-[10px]">Motor</p><p class="font-semibold text-[#ffffff]"><%= vehicle.numeroMotor %></p></div><% } %>
          <% if (vehicle.capacidadCarga) { %><div><p class="text-[#8b9bb4] text-[10px]">Cap. Carga</p><p class="font-semibold text-[#ffffff]"><%= vehicle.capacidadCarga %></p></div><% } %>
          <% if (vehicle.empresa) { %><div><p class="text-[#8b9bb4] text-[10px]">Empresa</p><p class="font-semibold text-[#ffffff]"><%= vehicle.empresa %></p></div><% } %>
        </div>

        <div class="h-px bg-[#d4af37]/15 my-3"></div>
        <div class="flex items-center gap-1.5 flex-wrap">
          <% const vtvBadgeC = vencimientos && vencimientos.find(x => x.label === 'VTV'); %>
          <% if (vtvBadgeC) { %>
            <% const vc = vtvBadgeC.dias === null ? 'text-[#8b9bb4] bg-white/10' : vtvBadgeC.dias < 0 ? 'text-red-300 bg-red-500/20' : vtvBadgeC.dias <= 30 ? 'text-yellow-300 bg-yellow-400/20' : 'text-green-300 bg-green-400/15'; %>
            <span class="status-badge <%= vc %>"><%= vtvBadgeC.dias === null ? 'VTV sin fecha' : vtvBadgeC.dias < 0 ? 'VTV vencida' : vtvBadgeC.dias <= 30 ? 'VTV ' + vtvBadgeC.dias + 'd' : 'VTV al día' %></span>
          <% } else { %>
            <span class="status-badge text-[#8b9bb4] bg-white/10">VTV sin cargar</span>
          <% } %>
          <% const segBadgeC = vencimientos && vencimientos.find(x => x.label === 'Seguro'); %>
          <% if (segBadgeC) { %>
            <% const sc = segBadgeC.dias === null ? 'text-[#8b9bb4] bg-white/10' : segBadgeC.dias < 0 ? 'text-red-300 bg-red-500/20' : segBadgeC.dias <= 30 ? 'text-yellow-300 bg-yellow-400/20' : 'text-green-300 bg-green-400/15'; %>
            <span class="status-badge <%= sc %>"><%= segBadgeC.dias === null ? 'Seguro sin fecha' : segBadgeC.dias < 0 ? 'Seguro vencido' : segBadgeC.dias <= 30 ? 'Seguro ' + segBadgeC.dias + 'd' : 'Seguro al día' %></span>
          <% } %>
        </div>
      </div>

      <% if (vencimientos && vencimientos.length) { %>
      <div class="glass-card rounded-2xl p-4 sm:p-5 mb-3">
        <h2 class="text-sm font-bold text-gradient-primary mb-3">Vencimientos</h2>
        <div class="space-y-2">
          <% vencimientos.forEach(vc => {
            const fechaTxt = vc.date ? vc.date.toLocaleDateString('es-AR') : '';
            const dias = vc.dias;
            let txt, cls;
            if (dias === null) { txt = 'Sin fecha'; cls = 'text-[#4a5568] bg-white/5'; }
            else if (dias < 0) { txt = 'Vencido'; cls = 'text-red-400 bg-red-500/10'; }
            else if (dias <= 30) { txt = 'Vence en ' + dias + 'd'; cls = 'text-yellow-400 bg-yellow-400/10'; }
            else { txt = 'Al día'; cls = 'text-green-400 bg-green-400/10'; }
          %>
          <div class="flex items-center justify-between gap-2 bg-white/[0.03] rounded-lg px-3 py-2 border border-white/5">
            <div class="min-w-0">
              <p class="text-[#ffffff] font-semibold text-xs"><%= vc.label %></p>
              <p class="text-[#4a5568] text-[10px] truncate"><%= vc.sub %><%= vc.sub && fechaTxt ? ' · ' : '' %><%= fechaTxt %></p>
            </div>
            <span class="status-badge <%= cls %> flex-shrink-0"><%= txt %></span>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (vehicle.chofer || vehicle.dni || vehicle.registro || vehicle.centroTrabajo) { %>
      <div class="glass-card rounded-2xl p-4 sm:p-5 mb-3">
        <h2 class="text-sm font-bold text-gradient-primary mb-3">Chofer</h2>
        <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
          <% if (vehicle.chofer) { %><div><p class="text-[#8b9bb4] text-[10px]">Chofer</p><p class="font-semibold text-[#ffffff]"><%= vehicle.chofer %></p></div><% } %>
          <% if (vehicle.dni) { %><div><p class="text-[#8b9bb4] text-[10px]">DNI</p><p class="font-semibold text-[#ffffff]"><%= vehicle.dni %></p></div><% } %>
          <% if (vehicle.registro) { %><div><p class="text-[#8b9bb4] text-[10px]">Registro</p><p class="font-semibold text-[#ffffff]"><%= vehicle.registro %></p></div><% } %>
          <% if (vehicle.centroTrabajo) { %><div><p class="text-[#8b9bb4] text-[10px]">Centro Trabajo</p><p class="font-semibold text-[#ffffff]"><%= vehicle.centroTrabajo %></p></div><% } %>
        </div>
      </div>
      <% } %>

      <% if (vehicle.observaciones) { %>
      <div class="glass-card rounded-2xl p-4 sm:p-5 mb-3">
        <h2 class="text-sm font-bold text-gradient-primary mb-1">Observaciones</h2>
        <p class="text-[#8b9bb4] text-xs"><%= vehicle.observaciones %></p>
      </div>
      <% } %>

      <% const fmtDate = (d) => { if (!d) return ''; const dd = d.toDate ? d.toDate() : new Date(d); return dd.toLocaleDateString('es-AR'); }; %>
      <% const svcEntries = Object.entries(vehicle.serviceSummary || {})
        .map(([tipo, s]) => ({ tipo, ...s }))
        .filter(s => s && (s.proximoKm != null || s.proximoFecha))
        .sort((a, b) => (a.proximoKm != null ? a.proximoKm : Infinity) - (b.proximoKm != null ? b.proximoKm : Infinity));
        if (vehicle.proximoServiceKm || vehicle.proximoServiceFecha || svcEntries.length) {
          const fSvc = vehicle.proximoServiceFecha?.toDate ? vehicle.proximoServiceFecha.toDate() : (vehicle.proximoServiceFecha ? new Date(vehicle.proximoServiceFecha) : null);
      %>
      <div class="glass-card rounded-2xl p-4 sm:p-5 mb-3">
        <h2 class="text-sm font-bold text-gradient-primary mb-2">Próximos Services</h2>
        <div class="grid grid-cols-2 gap-3 text-xs">
          <% if (vehicle.proximoServiceKm) { %><div class="bg-white/[0.03] rounded-xl p-3 text-center border border-white/5"><p class="text-[#8b9bb4] text-[10px]">Kilometraje</p><p class="font-bold text-[#ffffff]"><%= Number(vehicle.proximoServiceKm).toLocaleString('es-AR') %> km</p></div><% } %>
          <% if (fSvc) {
            const dSvc = Math.ceil((fSvc - new Date()) / 86400000);
            const cSvc = dSvc <= 0 ? 'text-red-400' : dSvc <= 7 ? 'text-yellow-400' : 'text-green-400';
          %><div class="bg-white/[0.03] rounded-xl p-3 text-center border border-white/5"><p class="text-[#8b9bb4] text-[10px]">Fecha</p><p class="font-bold <%= cSvc %>"><%= fSvc.toLocaleDateString('es-AR') %></p></div>
          <% } %>
        </div>
        <% if (svcEntries.length) { %>
        <div class="mt-3 space-y-1.5">
          <% svcEntries.forEach(s => {
            const f = s.proximoFecha ? (s.proximoFecha.toDate ? s.proximoFecha.toDate() : new Date(s.proximoFecha)) : null;
            const dueKm = s.proximoKm != null;
            const dueDate = f && Math.ceil((f - new Date()) / 86400000) <= 0;
          %>
          <div class="flex items-center justify-between gap-2 bg-white/[0.03] rounded-lg px-3 py-2 border border-white/5">
            <span class="font-semibold text-[#ffffff] text-xs truncate"><%= s.tipo || 'Sin tipo' %></span>
            <span class="text-[#8b9bb4] text-xs whitespace-nowrap">
              <%= dueKm ? Number(s.proximoKm).toLocaleString('es-AR') + ' km' : '' %><%= dueKm && f ? ' · ' : '' %><%= f ? fmtDate(f) : '' %><%= !dueKm && !f ? '—' : '' %>
            </span>
          </div>
          <% }); %>
        </div>
        <% } %>
      </div>
      <% } %>

      <% if ((recentServices && recentServices.length) || (recentRepuestos && recentRepuestos.length)) { %>
      <div class="glass-card rounded-2xl p-4 sm:p-5 mb-3">
        <h2 class="text-sm font-bold text-gradient-primary mb-3">Últimos movimientos</h2>
        <div class="space-y-2">
          <% (recentRepuestos || []).forEach(r => { %>
          <div class="flex items-start justify-between gap-2 bg-white/[0.03] rounded-lg px-3 py-2 border border-white/5">
            <div class="min-w-0">
              <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold mr-2" style="background:#10B98120;color:#10B981">Repuesto</span>
              <span class="font-semibold text-[#ffffff] text-xs"><%= r.pieza || '—' %></span>
              <% if (r.tipo) { %><span class="text-[#8b9bb4] text-[11px]">· <%= r.tipo %></span><% } %>
            </div>
            <div class="text-right flex-shrink-0 text-[11px] text-[#8b9bb4]"><%= fmtDate(r.fecha) %><% if (r.km != null) { %><br><span class="text-[#4a5568]"><%= Number(r.km).toLocaleString('es-AR') %> km</span><% } %></div>
          </div>
          <% }); %>
          <% (recentServices || []).forEach(s => { %>
          <div class="flex items-start justify-between gap-2 bg-white/[0.03] rounded-lg px-3 py-2 border border-white/5">
            <div class="min-w-0">
              <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold mr-2" style="background:#F59E0B20;color:#F59E0B">Service</span>
              <span class="font-semibold text-[#ffffff] text-xs"><%= s.tipo || '—' %></span>
              <% if (s.fluido) { %><span class="text-[#F59E0B] text-[11px]">+ <%= s.fluido %></span><% } %>
            </div>
            <div class="text-right flex-shrink-0 text-[11px] text-[#8b9bb4]"><%= fmtDate(s.fecha) %><% if (s.km != null) { %><br><span class="text-[#4a5568]"><%= Number(s.km).toLocaleString('es-AR') %> km</span><% } %></div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>




      <div class="glass-card rounded-2xl p-4 sm:p-5 mb-3">
        <h2 class="text-sm font-bold text-gradient-primary mb-1">Documentos del vehículo</h2>
        <p class="text-[#8b9bb4] text-[10px] mb-3">Cédula · Seguro · VTV — solo lectura</p>
        <div class="space-y-2">
          <% const docRows = [ { key: 'cedula', label: 'Cédula' }, { key: 'seguro', label: 'Seguro' }, { key: 'vtv', label: 'VTV' } ]; %>
          <% docRows.forEach(d => { const doc = (docsCarpeta || {})[d.key]; %>
          <div class="flex items-center justify-between gap-2 bg-white/[0.03] rounded-lg px-3 py-2.5 border border-white/5">
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="w-8 h-8 rounded-lg bg-teal-400/10 border border-teal-400/20 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-teal-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </span>
              <p class="text-[#ffffff] font-semibold text-xs truncate"><%= d.label %><% if (doc) { %><span class="text-[#4a5568] font-normal"> · <%= doc.nombre %></span><% } %></p>
            </div>
            <% if (doc) { %>
            <a href="<%= doc.url %>" target="_blank" rel="noopener" class="px-2.5 py-1 rounded-md text-[11px] font-semibold border border-teal-400/30 text-teal-300 hover:bg-teal-400/10 transition-colors flex-shrink-0">Ver</a>
            <% } else { %>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white/5 text-[#8b9bb4] flex-shrink-0">No disponible</span>
            <% } %>
          </div>
          <% }); %>
        </div>
      </div>

      <div class="text-center mt-4 pb-4">
        <p class="text-[#4a5568] text-[10px]">Grupo Falpat SRL — Control de Mantenimiento</p>
      </div>
    </div>
  </div>

  <div id="login-modal" class="login-overlay hidden">
    <div class="w-full max-w-sm">
      <div class="glass-card rounded-2xl p-6" style="background:rgba(15,15,35,0.95); border:1px solid rgba(212,175,55,0.3);">
        <div class="text-center mb-6">
          <div class="w-14 h-14 bg-gradient-to-br from-[#d4af37] to-[#d4af37] rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-lg shadow-[#d4af37]/30">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <h2 class="text-lg font-bold text-[#ffffff]">Acceso Admin</h2>
          <p class="text-[#8b9bb4] text-xs mt-1">Ingresá tus credenciales para editar</p>
        </div>
        <div id="login-error" class="hidden mb-3 p-2 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-xs text-center"></div>
        <div class="space-y-3">
          <input type="email" id="login-email" class="input-field" placeholder="Email" autocomplete="email">
          <input type="password" id="login-password" class="input-field" placeholder="Contraseña" autocomplete="current-password">
          <button onclick="doLogin()" id="btn-login" class="btn-primary">Ingresar</button>
          <button onclick="closeLoginModal()" class="btn-secondary">Cancelar</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const firebaseConfig = <%- JSON.stringify(clientConfig) %>;
    if (firebaseConfig && firebaseConfig.apiKey && !firebase.apps.length) {
      firebase.initializeApp(firebaseConfig);
    }

    function openLoginModal() {
      document.getElementById('login-modal').classList.remove('hidden');
      document.getElementById('login-email').focus();
    }
    function closeLoginModal() {
      document.getElementById('login-modal').classList.add('hidden');
      document.getElementById('login-error').classList.add('hidden');
    }
    async function doLogin() {
      const email = document.getElementById('login-email').value.trim();
      const pass = document.getElementById('login-password').value;
      const errDiv = document.getElementById('login-error');
      const btn = document.getElementById('btn-login');
      if (!email || !pass) { errDiv.textContent = 'Completá email y contraseña'; errDiv.classList.remove('hidden'); return; }
      btn.textContent = 'Ingresando...';
      btn.disabled = true;
      errDiv.classList.add('hidden');
      try {
        await firebase.auth().signInWithEmailAndPassword(email, pass);
        const idToken = await firebase.auth().currentUser.getIdToken();
        const res = await fetch('/api/auth/session', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ idToken }) });
        if (res.ok) { window.location.reload(); }
        else { const d = await res.json(); errDiv.textContent = d.error || 'Error al iniciar sesión'; errDiv.classList.remove('hidden'); }
      } catch (e) {
        let msg = 'Error al iniciar sesión';
        if (e.code === 'auth/user-not-found') msg = 'Usuario no encontrado';
        else if (e.code === 'auth/wrong-password') msg = 'Contraseña incorrecta';
        else if (e.code === 'auth/invalid-email') msg = 'Email inválido';
        else if (e.code === 'auth/too-many-requests') msg = 'Demasiados intentos. Esperá un momento';
        else msg = e.message;
        errDiv.textContent = msg;
        errDiv.classList.remove('hidden');
      }
      btn.textContent = 'Ingresar';
      btn.disabled = false;
    }
    document.getElementById('login-password')?.addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });
    document.getElementById('login-email')?.addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('login-password').focus(); });


  </script>
</body>
</html>