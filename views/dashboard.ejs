<%- include('partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('partials/sidebar', { page: 'dashboard' }) %>

  <div class="flex-1 flex flex-col overflow-hidden min-w-0">
    <%- include('partials/topbar', { page: 'dashboard' }) %>

    <main class="flex-1 overflow-y-auto p-4 md:p-6 space-y-6">

      <!-- ══ Encabezado ══ -->
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
        <div class="min-w-0">
          <h1 class="title-page">Panel de control</h1>
          <p class="t-muted text-sm mt-0.5">Estado general de la flota de Grupo Falpat</p>
        </div>
        <!-- Buscador -->
        <div class="relative flex-1 lg:w-72 lg:flex-none">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 t-subtle pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
          <input type="text" id="dash-search" placeholder="Buscar patente, marca, empresa..." class="input !pl-10">
          <div id="dash-search-results" class="hidden absolute top-full left-0 right-0 mt-2 card overflow-hidden z-30 max-h-80 overflow-y-auto"></div>
        </div>
      </div>

      <!-- ══ TIER 1 — 4 KPIs "norte": se leen en 1 segundo ══ -->
      <section aria-label="Indicadores principales" class="rise" style="--i:0">
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3">

          <!-- 1. Flota activa -->
          <article class="kpi rise" style="--kpi-tone: var(--ac); --i:1">
            <span class="kpi-shine" aria-hidden="true"></span>
            <h2 class="kpi__label">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25"/></svg>
              Flota activa
            </h2>
            <p class="kpi__value"><span id="kpi-flota-val">0</span></p>
            <div class="kpi__foot">
              <span class="kpi__hint" id="kpi-flota-hint">—</span>
              <button onclick="showVehiculosModal()" class="btn btn-ghost btn-sm !min-h-0 !px-2 !py-0.5 !text-[var(--fs-micro)] uppercase tracking-wider">Ver <span aria-hidden="true">→</span></button>
            </div>
          </article>

          <!-- 2. Vencidos (crítico) -->
          <article class="kpi rise" style="--kpi-tone: var(--dan); --i:2">
            <span class="kpi-shine" aria-hidden="true"></span>
            <h2 class="kpi__label">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
              Vencidos hoy
            </h2>
            <p class="kpi__value" style="color: var(--dan-text)"><span id="kpi-vencidos-val">0</span></p>
            <div class="kpi__foot">
              <span class="kpi__hint" id="kpi-vencidos-hint">documentos vencidos</span>
            </div>
          </article>

          <!-- 3. Vencen ≤30 días (con distribución real) -->
          <article class="kpi rise" style="--kpi-tone: var(--warn); --i:3">
            <span class="kpi-shine" aria-hidden="true"></span>
            <h2 class="kpi__label">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Vencen en 30 días
            </h2>
            <p class="kpi__value" style="color: var(--warn-text)"><span id="kpi-proximas-val">0</span></p>
            <svg class="kpi__spark" id="kpi-proximas-spark" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true"></svg>
            <div class="kpi__foot">
              <span class="kpi__hint" id="kpi-proximas-hint">—</span>
            </div>
          </article>

          <!-- 4. Documentación completa -->
          <article class="kpi rise" style="--kpi-tone: var(--ok); --i:4">
            <span class="kpi-shine" aria-hidden="true"></span>
            <h2 class="kpi__label">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Documentación completa
            </h2>
            <p class="kpi__value" style="color: var(--ok-text)"><span id="kpi-docs-val">0</span><small>%</small></p>
            <div class="meter mt-0.5" style="--meter-tone: var(--ok)">
              <div class="meter__track"><div class="meter__fill" id="kpi-docs-meter" style="width:0%"></div></div>
            </div>
            <div class="kpi__foot">
              <span class="kpi__hint" id="kpi-docs-hint">—</span>
            </div>
          </article>

        </div>
      </section>

      <!-- ══ TIER 2 — Exceptions-first: lo que hay que resolver, arriba ══ -->
      <section aria-label="Requiere atención" class="grid grid-cols-1 xl:grid-cols-3 gap-4 rise" style="--i:5">
        <div class="card overflow-hidden xl:col-span-2">
          <div class="section-head">
            <h2 class="section-head__title">
              <span class="dot dot--dan"></span>
              Requiere atención
            </h2>
            <span class="badge badge-ac" id="att-count">0</span>
          </div>
          <div id="att-list" class="exc max-h-[420px] overflow-y-auto"></div>
        </div>

        <!-- Salud de flota -->
        <div class="card p-5">
          <h2 class="section-head__title mb-1">Salud de la flota</h2>
          <p class="t-subtle text-xs mb-4">Según vencimientos de VTV, Seguro, Registro y DNI</p>
          <div class="mb-4">
            <div class="flex items-baseline justify-between mb-2">
              <span class="text-sm font-semibold t-strong">Al día</span>
              <span class="font-mono text-2xl font-bold t-strong"><span id="fh-ok">0</span><span class="text-sm t-subtle font-medium">/<span id="fh-total">0</span></span></span>
            </div>
            <div class="meter__track h-2">
              <div class="meter__fill" id="fleet-health-fill" style="width:0%; background: var(--ok)"></div>
            </div>
          </div>
          <div class="space-y-2">
            <div class="flex items-center gap-2.5 text-sm">
              <span class="dot dot--ok"></span>
              <span class="t-muted flex-1">Sin pendientes</span>
              <span class="font-mono font-bold t-ok" id="fh-ok-2">0</span>
            </div>
            <div class="flex items-center gap-2.5 text-sm">
              <span class="dot dot--warn"></span>
              <span class="t-muted flex-1">Vencen ≤30 días</span>
              <span class="font-mono font-bold" style="color: var(--warn-text)" id="fh-warn">0</span>
            </div>
            <div class="flex items-center gap-2.5 text-sm">
              <span class="dot dot--dan"></span>
              <span class="t-muted flex-1">Vencidos</span>
              <span class="font-mono font-bold" style="color: var(--dan-text)" id="fh-crit">0</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ TIER 3 — Banda de soporte: detalle por tipo + actividad ══ -->
      <section aria-label="Detalle por tipo de documento" class="rise" style="--i:6">
        <div class="section-head">
          <h2 class="section-head__title">Detalle por tipo de documento</h2>
          <span class="t-subtle text-xs">Cuántos vencen en 30 días o menos</span>
        </div>
        <div class="alert-strip grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
          <% const alerts = [
            { k:'vtv',       n:'VTV',       ico:'<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>', fn:'showVtvAlertModal()' },
            { k:'seguro',    n:'Seguro',    ico:'<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>', fn:'showSeguroModal()' },
            { k:'cedula',    n:'Cédula',    ico:'<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>', fn:'showCedulaModal()' },
            { k:'matafuego', n:'Matafuego', ico:'<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z"/>', fn:'showMatafuegoModal()' },
            { k:'registro',  n:'Registro',  ico:'<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25M9 16.5v.75m3-3v3M15 12v5.25m-4.5-15H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>', fn:'showRegistroModal()' },
            { k:'dni',       n:'DNI',       ico:'<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>', fn:'showDniModal()' },
            { k:'service',   n:'Service',   ico:'<path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.501-.959.221-.203.48-.423.755-.687a.75.75 0 111.06 1.06c-.33.33-.547.55-.687.755a1.515 1.515 0 01-.959.501c-.333.067-.667.1-1 .1s-.667-.033-1-.1zM21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>', fn:'showServiceModal()' }
          ]; %>
          <% alerts.forEach(a => { %>
          <article class="alert-card" data-alert="<%= a.k %>" data-sev="none" onclick="<%= a.fn %>" tabindex="0" role="button" aria-label="Ver <%= a.n %> por vencer">
            <span class="alert-card__flag" aria-hidden="true"></span>
            <div class="alert-card__top">
              <span class="alert-card__ico">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><%- a.ico %></svg>
              </span>
              <span class="alert-card__count" id="card-<%= a.k %>-proximos"><span class="skeleton skeleton-stat inline-block"></span></span>
            </div>
            <h3 class="alert-card__title"><%= a.n %></h3>
            <p class="alert-card__meta" id="card-<%= a.k %>-docs"></p>
          </article>
          <% }); %>
        </div>
      </section>

      <section aria-label="Actividad" class="grid grid-cols-1 xl:grid-cols-12 gap-4 rise" style="--i:7">
        <!-- Empresas: ranking con la proporción real de cada empresa -->
        <div class="card p-4 xl:col-span-4 flex flex-col">
          <header class="flex items-start justify-between gap-3 mb-2">
            <div class="min-w-0">
              <h2 class="section-head__title">Empresas</h2>
              <p class="t-subtle text-xs mt-0.5">Vehículos por empresa</p>
            </div>
            <span class="badge badge-ac shrink-0" id="empresas-total">—</span>
          </header>
          <div id="empresas-list" class="emp-list"></div>
          <footer class="emp-foot" id="empresas-foot"></footer>
        </div>

        <!-- Últimos services: el service más reciente de cada vehículo -->
        <div class="card p-4 xl:col-span-8 flex flex-col">
          <header class="flex items-start justify-between gap-3 mb-2">
            <div class="min-w-0">
              <h2 class="section-head__title">Últimos services</h2>
              <p class="t-subtle text-xs mt-0.5">Service más reciente por vehículo</p>
            </div>
            <span class="badge badge-ac hidden shrink-0" id="latest-services-count"></span>
          </header>
          <div id="latest-services-list" class="svc-list"></div>
        </div>
      </section>

      <!-- Modal -->
      <div id="dash-modal" class="fixed inset-0 z-50 hidden">
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" onclick="closeDashModal()"></div>
        <div class="relative min-h-full flex items-center justify-center p-4">
          <div class="card w-full max-w-lg overflow-hidden shadow-2xl">
            <div class="p-5 flex items-center gap-3 hairline">
              <div id="dash-modal-icon" class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"></div>
              <div class="flex-1 min-w-0">
                <h3 id="dash-modal-title" class="text-lg font-display font-bold t-strong truncate"></h3>
                <p id="dash-modal-subtitle" class="text-xs t-muted mt-0.5 truncate"></p>
              </div>
              <button onclick="closeDashModal()" class="btn btn-ghost btn-sm !min-h-0 !p-2" aria-label="Cerrar">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <div id="dash-modal-body" class="px-5 py-4 max-h-80 overflow-y-auto space-y-2"></div>
            <div id="dash-modal-footer" class="px-5 py-3 hairline flex justify-end">
              <button onclick="closeDashModal()" class="btn btn-secondary btn-sm">Cerrar</button>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<%- include('partials/mobile-menu', { page: 'dashboard' }) %>

<script src="/js/dashboard.js?v=<%= Date.now() %>"></script>
<script>
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDashModal(); });
</script>
<%- include('partials/footer') %>
