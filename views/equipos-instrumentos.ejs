          ${campo('5 · Elemento Proveta *',`<select id="w-proveta" class="input" ${cat==='Probetas'?'':'disabled'} onchange="updateDraft()">${opts(ELEMENTOS_PROVETA,draft.elemento)}</select>`,cat==='Probetas'?'':'Oculto para esta categoría.')}
