    function actualizarEstado(){
      const resultado=Number($('w-resultado').value),referencia=Number($('w-referencia').value),tol=Number(TOLERANCIAS[$('w-equipo').value]);
      const valido=!Number.isNaN(resultado)&&!Number.isNaN(referencia)&&referencia!==0&&!Number.isNaN(tol);
      const desv=valido?Math.abs(resultado-referencia)/Math.abs(referencia)*100:null;
      const apto=desv!=null&&desv<=tol;
      draft.referencia=$('w-referencia').value;draft.tolerancia=tol;draft.desviacion=desv==null?'':Number(desv.toFixed(2));draft.estado=desv==null?'':(apto?'Apto':'No apto');
      $('w-tolerancia').value='±'+fmtPct(tol)+' %';
      $('w-desviacion').value=desv==null?'':(fmtPct(draft.desviacion)+' %');
      $('w-estado').innerHTML=desv==null?'<span class="badge badge-muted">Sin calcular</span>':`<span class="badge ${apto?'badge-ok':'badge-danger'}">${apto?'Apto':'No apto'}</span>`;
      const accion=$('w-accion');if(accion){accion.disabled=apto||desv==null;if(apto||desv==null){accion.value='';draft.accion='';}else draft.accion=accion.value;}
