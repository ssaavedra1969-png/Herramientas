          ${campo('11 · Acción tomada',`<select id="w-accion" class="input" ${draft.estado==='No apto'?'':'disabled'} onchange="updateDraft()"><option value="">Seleccione…</option>${opts(ACCIONES,draft.accion)}</select>`,'Se habilita y es obligatoria solo cuando el estado es No apto.')}
          ${campo('12 · Fecha De Control *',`<input id="w-fecha" class="input" type="date" value="${esc(draft.fecha||'2026-11-27')}" onchange="onFecha()">`)}
          ${campo('13 · Periodicidad *',`<select id="w-periodicidad" class="input" onchange="onPeriodicidad()">${optsPeriod(draft.periodicidad||30)}</select>`,'Diaria, Semanal, Mensual y las restantes.')}
          ${campo('14 · Próximo Control (calculado)',`<div style="display:flex;gap:6px"><input id="w-proximo" class="input" type="date" value="${esc(draft.proximo||'')}"><button class="btn btn-secondary btn-sm" type="button" onclick="calcularProximo()">Calcular</button></div>`,'Se calcula con Fecha De Control + Periodicidad.')}
          ${campo('15 · Certificado',`<button class="btn btn-secondary btn-sm" type="button" onclick="adjuntarDoc()">Adjuntar documentación</button><div id="w-docs"></div>`,'Toda la documentación respaldatoria del ensayo.')}
        </div>`;
        if(cat==='Probetas'&&!ELEMENTOS_PROVETA.includes(draft.elemento))draft.elemento='';
        if(cat==='Aridos'&&!ELEMENTOS_ARIDOS.includes(draft.elemento))draft.elemento='';
        actualizarEstado();
      }else{
        box.innerHTML='<div class="notice"><b>Pruebas/Ensayos · Balanza</b><br>El formulario de pruebas y ensayos está definido solo para el sector <b>Laboratorio</b>. Cambiá el sector a Laboratorio o elegí <b>Mantenimiento de Instrumentos</b>.</div>';
        save.disabled=true;return;
      }
      renderDocs();if(!$('w-proximo').value)calcularProximo();
    }
    function onCategoria(){updateDraft();const cat=$('w-categoria').value;draft.categoria=cat;draft.aridos='';draft.proveta='';draft.elemento='';renderDynamic();}
    function onEquipoPrueba(){updateDraft();const equipo=$('w-equipo').value,permitidas=pruebasPara(equipo);if(!permitidas.includes(draft.prueba))draft.prueba='';if(equipo==='Cocina'){draft.categoria='Aridos';draft.aridos='';draft.proveta='';draft.elemento='';}renderDynamic();}
    function onFecha(){updateDraft();calcularProximo();}
    function onPeriodicidad(){updateDraft();calcularProximo();}
    function calcularProximo(){const f=$('w-fecha').value,p=$('w-periodicidad').value;if(f&&p){$('w-proximo').value=addDays(f,p);updateDraft();}}
    function renderDocs(){const el=$('w-docs');if(!el)return;el.innerHTML=adjuntos.map((d,i)=>`<span class="doc-chip">${esc(d)}<button type="button" onclick="quitarDoc(${i})">✕</button></span>`).join('');}
    function adjuntarDoc(){const tipo=$('w-tipo').value;const base=tipo==='Pruebas/Ensayos'?(draft.prueba==='Humedad'?'informe_humedad':'informe_ensayo'):'certificado_control';adjuntos.push(`${base}_${String(adjuntos.length+1).padStart(2,'0')}_2026-11-27.pdf`);renderDocs();toast('Documento de demostración adjuntado.','info');}
    function quitarDoc(i){adjuntos.splice(i,1);renderDocs();}
    function guardarRegistro(){
      updateDraft();
      const planta=$('w-planta').value,sector=$('w-sector').value,tipo=$('w-tipo').value;
      if(tipo==='Pruebas/Ensayos'&&$('w-referencia'))actualizarEstado();
      if(!planta||!sector||!tipo){toast('Completá los 3 primeros pasos.','err');return;}
      if(!draft.equipo||!draft.fecha||!draft.periodicidad){toast('Completá equipo, fecha y periodicidad.','err');return;}
      if(!adjuntos.length){toast('Adjuntá al menos un certificado o documento de respaldo.','err');return;}
      let r;
      if(tipo==='Mantenimiento de Instrumentos'){
        if(!draft.tipo_mant){toast('Seleccioná el tipo de mantenimiento.','err');return;}
        r={id:editandoId||('M-'+String(Math.max(0,...registros.filter(x=>x.parte==='mant').map(x=>Number(x.id.slice(2))))+1).padStart(3,'0')),parte:'mant',planta,sector,equipo:draft.equipo,tipo:draft.tipo_mant,fecha:draft.fecha,periodicidad:Number(draft.periodicidad),proximo:draft.proximo||addDays(draft.fecha,draft.periodicidad),docs:adjuntos.slice()};
      }else{
        if(sector!=='Laboratorio'){toast('Pruebas/Ensayos solo está definido para Laboratorio.','err');return;}
        const elem=draft.categoria==='Probetas'?(draft.proveta||draft.elemento):(draft.aridos||draft.elemento);
        if(!draft.prueba||!draft.categoria||!elem){toast('Completá prueba, categoría y elemento.','err');return;}
        if(!pruebasPara(draft.equipo).includes(draft.prueba)){toast('El tipo de prueba no corresponde al equipo seleccionado.','err');return;}
        if(draft.prueba==='Humedad'&&draft.categoria!=='Aridos'){toast('La humedad se mide sobre áridos.','err');return;}
        if(draft.resultado===''||draft.resultado==null||Number.isNaN(Number(draft.resultado))){toast(draft.prueba==='Humedad'?'Completá el valor de humedad.':'Completá el valor resultado.','err');return;}
        if(draft.referencia===''||draft.referencia==null||Number.isNaN(Number(draft.referencia))||Number(draft.referencia)===0){toast('Completá el valor de referencia/patrón (distinto de cero).','err');return;}
        if(!draft.estado){toast('Completá resultado y referencia para calcular el estado.','err');return;}
        if(draft.estado==='No apto'&&!draft.accion){toast('Completá la acción tomada para el equipo no apto.','err');return;}
        r={id:editandoId||('P-'+String(Math.max(0,...registros.filter(x=>x.parte==='prueba').map(x=>Number(x.id.slice(2))))+1).padStart(3,'0')),parte:'prueba',planta,sector,equipo:draft.equipo,prueba:draft.prueba,categoria:draft.categoria,elemento:elem,resultado:Number(draft.resultado),referencia:Number(draft.referencia),tolerancia:Number(draft.tolerancia),desviacion:draft.desviacion===''?null:Number(draft.desviacion),estado:draft.estado,accion:draft.estado==='No apto'?draft.accion:'',fecha:draft.fecha,periodicidad:Number(draft.periodicidad),proximo:draft.proximo||addDays(draft.fecha,draft.periodicidad),docs:adjuntos.slice()};
      }
      registros=editandoId?registros.map(x=>x.id===editandoId?r:x):registros.concat(r);
      renderTodo();cambiarParte(r.parte);cerrarForm();toast(editandoId?'Registro actualizado.':'Registro guardado.','ok');
    }
    function abrirDetalle(id){const r=registros.find(x=>x.id===id);if(!r)return;detalleId=id;const s=estado(r);const f=(k,v)=>`<div class="def-item"><div class="k">${k}</div><div class="v">${v}</div></div>`;
      const base=[[ 'id',r.id],['Planta/Ubicación',r.planta],['Sector',r.sector],['Equipo',r.equipo],['Fecha De Control',fmt(r.fecha)],['Periodicidad',r.periodicidad+' días'],['Próximo Control',fmt(r.proximo)]];
      const extra=r.parte==='mant'?[['Tipo de Mantenimiento',r.tipo]]:[['Tipo de Prueba/Ensayo',r.prueba],['Categoría',r.categoria],['Elemento',r.elemento],[r.prueba==='Humedad'?'Valor humedad (%)':'Valor resultado',r.resultado],['Tolerancia admitida','±'+fmtPct(r.tolerancia)+' %'],['Valor de referencia/patrón',r.referencia],['Desviación obtenida (%)',r.desviacion==null?'—':fmtPct(r.desviacion)+' %'],['Estado',r.estado],['Acción tomada',r.accion||'—']];
      $('det-titulo').textContent=`${r.id} · ${r.equipo}`;
      $('det-body').innerHTML=`<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px"><span class="badge ${s.c}">${s.k} · ${Math.abs(s.d)} días</span><span class="badge badge-ac">${r.parte==='mant'?'Mantenimiento de Instrumentos':'Pruebas/Ensayos'}</span></div><div class="def-grid">${base.concat(extra).map(([k,v])=>f(k,esc(v))).join('')}</div><div class="def-item" style="margin-top:10px"><div class="k">Certificado · documentación respaldatoria</div><div class="v">${r.docs.map((d,i)=>`<button class="btn btn-ghost btn-sm" onclick="verDoc('${r.id}',${i})">${esc(d)}</button>`).join(' ')}</div></div>`;
      $('modal-detalle').classList.remove('hidden');
    }
    function editarDesdeDetalle(){const id=detalleId;cerrar('modal-detalle');const r=registros.find(x=>x.id===id);abrirForm(r.parte,id);}
    function verDoc(id,i){const r=registros.find(x=>x.id===id);if(!r)return;const doc=r.docs[i]||r.docs[0];const datos=[];
      datos.push(['Planta/Ubicación',r.planta],['Sector',r.sector],['Equipo',r.equipo],['Fecha De Control',fmt(r.fecha)],['Periodicidad',r.periodicidad+' días'],['Próximo Control',fmt(r.proximo)]);
      if(r.parte==='mant')datos.push(['Tipo de Mantenimiento',r.tipo]);else datos.push(['Tipo de Prueba/Ensayo',r.prueba],['Categoría',r.categoria],['Elemento',r.elemento],[r.prueba==='Humedad'?'Valor humedad (%)':'Valor resultado',r.resultado],['Tolerancia admitida','±'+fmtPct(r.tolerancia)+' %'],['Valor de referencia/patrón',r.referencia],['Desviación obtenida (%)',r.desviacion==null?'—':fmtPct(r.desviacion)+' %'],['Estado',r.estado],['Acción tomada',r.accion||'—']);
      currentCert={titulo:r.parte==='mant'?'Certificado de control':(r.prueba==='Humedad'?'Informe de humedad':'Informe de prueba/ensayo'),codigo:r.id,descripcion:r.equipo,ruta:doc,datos};
      $('cert-ruta').textContent=doc;
      $('cert-paper').innerHTML=`<div class="cert-paper"><h3>${esc(currentCert.titulo)}</h3><div class="cert-sub">Grupo Falpat SRL · documento de demostración</div><div class="cert-grid"><div><b>Registro</b>${esc(r.id)}</div><div><b>Equipo</b>${esc(r.equipo)}</div>${datos.map(([k,v])=>`<div><b>${esc(k)}</b>${esc(v)}</div>`).join('')}</div><div class="cert-foot">Generado localmente para la demo · no reemplaza un certificado real</div></div>`;
      $('modal-cert').classList.remove('hidden');
    }
    function pdfClean(s){return String(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/\\/g,'\\\\').replace(/\(/g,'\\(').replace(/\)/g,'\\)');}
    function makeDemoPDF(){const lines=[currentCert.titulo.toUpperCase()+' - GRUPO FALPAT SRL','Registro: '+currentCert.codigo,'Equipo: '+currentCert.descripcion,'Documento: '+currentCert.ruta,...currentCert.datos.map(([k,v])=>k+': '+v),'Generado localmente para la demo.'];
      const stream='BT /F1 11 Tf 50 790 Td '+lines.map((l,i)=>(i?'0 -20 Td ':'')+'('+pdfClean(l)+') Tj').join(' ')+' ET';
      const objs=['<</Type/Catalog/Pages 2 0 R>>','<</Type/Pages/Kids[3 0 R]/Count 1>>','<</Type/Page/Parent 2 0 R/MediaBox[0 0 595 842]/Resources<</Font<</F1 4 0 R>>>>/Contents 5 0 R>>','<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>','<</Length '+stream.length+'>>\nstream\n'+stream+'\nendstream'];
      let pdf='%PDF-1.4\n',offs=[0];objs.forEach((o,i)=>{offs.push(pdf.length);pdf+=(i+1)+' 0 obj\n'+o+'\nendobj\n';});const x=pdf.length;
      pdf+='xref\n0 '+(objs.length+1)+'\n0000000000 65535 f \n'+offs.slice(1).map(o=>String(o).padStart(10,'0')+' 00000 n \n').join('')+'trailer\n<</Size '+(objs.length+1)+'/Root 1 0 R>>\nstartxref\n'+x+'\n%%EOF';
      return new Blob([pdf],{type:'application/pdf'});
    }
    function abrirCertPDF(){if(!currentCert)return;const u=URL.createObjectURL(makeDemoPDF());window.open(u,'_blank');setTimeout(()=>URL.revokeObjectURL(u),60000);}
    function descargarCertPDF(){if(!currentCert)return;const u=URL.createObjectURL(makeDemoPDF()),a=document.createElement('a');a.href=u;a.download=currentCert.codigo+'_demo.pdf';a.click();setTimeout(()=>URL.revokeObjectURL(u),60000);toast('PDF de demostración descargado.','ok');}
    function cerrar(id){$(id).classList.add('hidden');}
    function toast(msg,tipo){const t=$('toast');t.textContent=msg;t.className='toast '+(tipo==='err'?'err':tipo==='ok'?'ok':tipo==='warn'?'warn':'');t.classList.remove('hidden');clearTimeout(toast._t);toast._t=setTimeout(()=>t.classList.add('hidden'),3200);}
    document.addEventListener('DOMContentLoaded',()=>{
      initSelects();renderTodo();
      ['m-q','m-planta','m-sector','m-equipo','m-tipo','p-q','p-planta','p-equipo','p-prueba','p-categoria','p-estado'].forEach(id=>$(id).addEventListener('input',renderTablas));
      document.addEventListener('keydown',e=>{
        if(e.key==='Escape'){['modal-detalle','modal-form','modal-cert','modal-tolerancias'].forEach(cerrar);}
      });
      document.querySelectorAll('.modal-backdrop').forEach(b=>b.addEventListener('click',ev=>{if(ev.target===b&&b.id!=='modal-form')b.classList.add('hidden');}));
    });
  </script>
    </div>
  </div>
</div>

