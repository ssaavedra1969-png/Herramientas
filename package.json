{
  "name": "falpat-maintenance-control",
  "version": "1.0.0",
  "description": "Sistema de control de mantenimiento - Grupo Falpat SRL",
  "main": "server.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node --watch server.js",
    "backup": "node scripts/export-firebase.js",
    "restore": "node scripts/restore-firebase.js",
    "dev:snapshot": "node scripts/snapshot-dev.js",
    "dev:restore": "node scripts/restore-dev.js",
    "subir:docs": "node scripts/subir-documentos.js",
    "cargar:vencimientos": "node scripts/cargar-vencimientos.js",
    "generar:control": "node scripts/generar-control-documentacion.js",
    "generar:matafuego": "node scripts/generar-control-matafuego.js",
    "generar:pdf-seguros": "node scripts/generar-pdf-seguros.js",
    "copiar:docs-choferes": "node scripts/copiar-docs-choferes.js",
    "cargar:companias": "node scripts/cargar-compania-seguros.js",
    "limpiar:service": "node scripts/limpiar-service-fields.js",
    "test": "npm run test:escrituras && npm run test:negocio && npm run test:numeracion && npm run test:import && npm run test:deshabilitado",
    "test:escrituras": "node tests/escrituras.test.js",
    "test:negocio": "node tests/negocio.test.js",
    "test:numeracion": "node tests/vehiculos-numeracion.test.js",
    "test:import": "node tests/import-vehiculos.test.js",
    "test:deshabilitado": "node tests/deshabilitado-orden.test.js",
    "inspect:counters": "node scripts/inspeccionar-counters.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.6.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^7.1.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "pdf-lib": "^1.17.1",
    "xlsx": "^0.18.5"
  }
}
